# Nokia Network as Code (networkascode.nokia.io -> Console -> your application -> API key)
NAC_API_KEY=
# Public HTTPS URL of this server, used as the webhook sink for Geofencing / Reachability subscriptions
PUBLIC_BASE_URL=
# LLM for the planner / investigator / explainer (Resource & Tooling Guide tools only)
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional: Supabase (falls back to SQLite when unset)
SUPABASE_URL=
SUPABASE_KEY=
# Optional: Twilio supervisor alerts (never households)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SUPERVISOR_PHONE=
